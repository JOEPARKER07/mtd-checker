# Copy to .env and fill in. Nothing here should ever be committed with real values.

# --- Hosting/deploy (Phase 2) ---
# Vercel or Netlify token, once you create a free account and a project there.
# Get it from: Vercel dashboard > Settings > Tokens, or Netlify > User settings > Applications
DEPLOY_PROVIDER_TOKEN=

# --- Domain (Phase 2, requires your approval to purchase) ---
# Not a secret, just the chosen domain once bought, e.g. mtdchecker.co.uk
DOMAIN_NAME=

# --- Email capture tool (Phase 2) ---
# Free tier of e.g. Resend, Mailchimp, or Buttondown. Get an API key from their dashboard.
EMAIL_PROVIDER_API_KEY=

# --- Analytics (Phase 2) ---
# Free tier of e.g. Plausible or Umami (privacy-friendly, no cookie banner needed in most cases)
ANALYTICS_SITE_ID=
ANALYTICS_API_KEY=

# --- Affiliate programs (Phase 2/3, sign up directly, no purchase needed) ---
FREEAGENT_AFFILIATE_ID=
QUICKBOOKS_UK_AFFILIATE_ID=
XERO_AFFILIATE_ID=
COCONUT_AFFILIATE_ID=

# --- Distribution channels (Phase 3, only platforms you've explicitly approved) ---
# e.g. a Reddit/X API token for the distribution agent, scoped to approved subreddits/accounts only.
DISTRIBUTION_CHANNEL_TOKEN=
